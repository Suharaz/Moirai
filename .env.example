# Bootstrap variables only. Application API keys (CMC, OpenRouter, Binance, Telegram, news feed)
# are NEVER placed here: they are entered on the admin console and sealed per scope.
# In production every value below comes from a sops-encrypted file mounted as a docker secret;
# any variable NAME may instead be provided as NAME_FILE pointing to a file that holds the value.

# Dev Postgres superuser (docker-compose.dev.yml only)
POSTGRES_PASSWORD=

# Per-service Postgres role passwords (dev init script creates one role per service)
HDT_PG_PASSWORD_MIGRATOR=
HDT_PG_PASSWORD_RECORDER=
HDT_PG_PASSWORD_COUNCIL=
HDT_PG_PASSWORD_SCORER=
HDT_PG_PASSWORD_RISK=
HDT_PG_PASSWORD_EXECUTION=
HDT_PG_PASSWORD_NEWS=
HDT_PG_PASSWORD_VETO_SCAN=
HDT_PG_PASSWORD_CONFIGAPI=
HDT_PG_PASSWORD_CONSOLE_RO=
HDT_PG_PASSWORD_PUBLISHER_RO=
HDT_PG_PASSWORD_TELEGRAM=
HDT_PG_PASSWORD_BACKUP=
HDT_PG_PASSWORD_MONITOR=

# DSN of the role the current process runs as, e.g. postgresql+psycopg://hdt_risk:<pw>@127.0.0.1:5432/hdt
# (use 127.0.0.1, not localhost: on hosts with IPv6 enabled localhost may resolve to ::1 and hang)
HDT_PG_DSN=
# DSN used by Alembic (role hdt_migrator)
HDT_PG_DSN_MIGRATOR=
# Superuser DSN used only by the test suite to create per-session databases
HDT_TEST_PG_ADMIN_DSN=

# Per-service Redis ACL passwords (scripts/gen_redis_acl.py renders deploy/redis/users.acl)
HDT_REDIS_PASSWORD_ADMIN=
HDT_REDIS_PASSWORD_RECORDER=
HDT_REDIS_PASSWORD_COUNCIL=
HDT_REDIS_PASSWORD_NEWS=
HDT_REDIS_PASSWORD_VETO_SCAN=
HDT_REDIS_PASSWORD_SCORER=
HDT_REDIS_PASSWORD_RISK=
HDT_REDIS_PASSWORD_EXECUTION=
HDT_REDIS_PASSWORD_TESTNET_DRIVER=
HDT_REDIS_PASSWORD_CONFIGAPI=
HDT_REDIS_PASSWORD_CONSOLE=
HDT_REDIS_PASSWORD_PUBLISHER=
HDT_REDIS_PASSWORD_TELEGRAM=
HDT_REDIS_PASSWORD_MONITOR=
# URL of the ACL user the current process runs as, e.g. redis://council:<pw>@127.0.0.1:6379/0
HDT_REDIS_URL=

# Admin ACL user URL used only by the test suite (a random DB index is appended per session)
HDT_TEST_REDIS_URL=
# Secret file paths (docker secrets in production)
HDT_SCOPE_PRIVATE_KEY_FILE=
HDT_ORDER_SIGNING_KEY_FILE=
HDT_ORDER_VERIFY_KEYS_FILE=
HDT_SESSION_SECRET_FILE=
HDT_TLS_CERT_FILE=
HDT_TLS_KEY_FILE=
