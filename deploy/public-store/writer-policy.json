{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublisherObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::hdt-public/*"]
    },
    {
      "Sid": "PublisherListing",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::hdt-public"]
    }
  ]
}
