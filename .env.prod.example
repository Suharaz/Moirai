# Production compose variables (docker compose --env-file .env.prod ...). Copy to .env.prod on the VPS
# and replace every example value. Nothing here is secret: passwords, DSNs and keys are files under
# secrets/ (scripts/gen_prod_secrets.py and docs/deployment-guide.md section 3).

# Image tag of the locally built hdt/* images (e.g. the git commit being deployed).
HDT_IMAGE_TAG=local

# Public dashboard: DNS name pointing at the VPS public IP, and the ACME account e-mail.
HDT_PUBLIC_HOSTNAME=dashboard.example.com
HDT_ACME_EMAIL=ops@example.com

# Tailscale address of the VPS (`tailscale ip -4`): console, Grafana and Langfuse bind only here.
HDT_TAILSCALE_IP=100.64.0.1
HDT_GRAFANA_URL=http://100.64.0.1:3000
HDT_LANGFUSE_URL=http://100.64.0.1:3100
HDT_LANGFUSE_ADMIN_EMAIL=ops@example.com

# Backups (deploy/backup): s3://bucket[/prefix] with a write-only key in secrets/backup_s3_*, or
# file:///dir for a mounted disk. The S3 endpoint host is also allowlisted in egress-proxy, which refuses
# to start unless the endpoint is https://<DNS name> with no port or port 443.
HDT_BACKUP_TARGET=s3://hdt-backup/prod
HDT_BACKUP_S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
HDT_BACKUP_S3_REGION=ap-southeast-1
# age public keys (space separated) of the offline restore identities; see the runbook restore drill.
HDT_BACKUP_AGE_RECIPIENTS=age1qyqszqgpqyqszqgpqyqszqgpqyqszqgpqyqszqgpqyqszqgpqyqs3290gq
# UTC hour (0-23, decimal) at or after which the daily base + logical + lake backup runs.
HDT_BACKUP_HOUR_UTC=3
